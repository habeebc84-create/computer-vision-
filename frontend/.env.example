# Backend URL for the React frontend.
# Leave this commented out (or empty) when the frontend is served by the
# Python backend itself (python run.py) — /api/* calls then go to the same origin.
#
# When the frontend is hosted elsewhere (e.g. Vercel, which serves static files
# only and runs NO Python backend), set this to your backend's URL and rebuild:
#   VITE_API_URL=http://localhost:8000
#   VITE_API_URL=https://my-backend.onrender.com
# After changing this value you must run `npm run build` again and redeploy,
# because Vite bakes the value into the build at build time.
# VITE_API_URL=http://localhost:8000
